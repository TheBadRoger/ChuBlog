{$SITE_ADDRESS:localhost} {
    request_body {
        max_size 8KB
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        -Server
    }
    handle /api/* {
        reverse_proxy api:3001 {
            transport http {
                read_timeout 15s
                write_timeout 15s
            }
        }
    }
    handle {
        reverse_proxy web:4321 {
            transport http {
                read_timeout 15s
                write_timeout 15s
            }
        }
    }
    log {
        output stdout
        format json
    }
}
