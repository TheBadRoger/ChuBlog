# Optional on the self-hosted server; loaded by scripts/init-deps.py when these repos exist.
[url "file:///srv/git/ChuSQL.git"]
    insteadOf = ChuGit:/srv/git/ChuSQL.git
    insteadOf = ssh://git@chunana.cn/srv/git/ChuSQL.git
    insteadOf = git@chunana.cn:/srv/git/ChuSQL.git
    insteadOf = git@github.com:TheBadRoger/ChuSQL.git
    insteadOf = https://github.com/TheBadRoger/ChuSQL.git
[url "file:///srv/git/ChuSQL-RustDriver.git"]
    insteadOf = ChuGit:/srv/git/ChuSQL-RustDriver.git
    insteadOf = ssh://git@chunana.cn/srv/git/ChuSQL-RustDriver.git
    insteadOf = git@chunana.cn:/srv/git/ChuSQL-RustDriver.git
    insteadOf = git@github.com:TheBadRoger/ChuSQL-RustDriver.git
    insteadOf = https://github.com/TheBadRoger/ChuSQL-RustDriver.git
