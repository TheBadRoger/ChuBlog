# Optional project-local aliases. GitHub URLs deliberately remain untouched for fallback.
[url "ssh://git@localhost/srv/git/ChuSQL.git"]
    insteadOf = ChuGit:/srv/git/ChuSQL.git
    insteadOf = ssh://git@chunana.cn/srv/git/ChuSQL.git
    insteadOf = git@chunana.cn:/srv/git/ChuSQL.git
[url "ssh://git@localhost/srv/git/ChuSQL-RustDriver.git"]
    insteadOf = ChuGit:/srv/git/ChuSQL-RustDriver.git
    insteadOf = ssh://git@chunana.cn/srv/git/ChuSQL-RustDriver.git
    insteadOf = git@chunana.cn:/srv/git/ChuSQL-RustDriver.git
