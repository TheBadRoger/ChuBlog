PUBLIC_ORIGIN=https://blog.example.com
SITE_ADDRESS=blog.example.com
SITE_TITLE=ChuBlog
ADMIN_USERNAME=admin
# Generate via the temporary API container in docs/deployment.md; keep single quotes around the hash.
ADMIN_PASSWORD_HASH='$argon2id$REPLACE_WITH_GENERATED_HASH'
ALLOW_REGISTRATION=true
CHUSQL_ROOT_PASSWORD=replace-with-random-root-password-at-least-16-characters
CHUSQL_PASSWORD=replace-with-different-random-index-password-at-least-16-characters
SSH_PORT=2222
HTTP_PORT=80
HTTPS_PORT=443

# Tencent Cloud VPC image mirror. Outside Tencent Cloud, clear this value.
REGISTRY_PREFIX=mirror.ccs.tencentyun.com/library/
# Tencent VPC package mirrors. Rust and GHC arrive through the image registry above.
DEBIAN_MIRROR=mirrors.tencentyun.com
NPM_REGISTRY=https://mirrors.tencentyun.com/npm/
# Tencent does not list a Cargo mirror; use RsProxy externally. Empty selects crates.io.
CARGO_MIRROR_INDEX=sparse+https://rsproxy.cn/index/
