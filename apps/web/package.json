{
  "name": "chublog-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "start": "node dist/server/entry.mjs",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@astrojs/node": "11.1.8",
    "astro": "7.4.0",
    "markdown-it": "^14.1.0",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.19.2",
    "@types/sanitize-html": "^2.16.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
