---
import Base from '../layouts/Base.astro';
import { readApi, type SiteState } from '../lib/api';
let available = true;
try {
  if ((await readApi<SiteState>('/api/site')).installed) return Astro.redirect('/login');
} catch { available = false; Astro.response.status = 503; }
---
<Base title="安装博客" description="设置网站信息并创建站长账户。">
  <div class="setup-shell">
    <header class="page-heading"><h1>安装博客</h1><p>填写网站信息，创建你的站长账户。</p></header>
    {available ? <>
      <p class="notice">安装只需完成一次。站长账户唯一，安装完成后入口关闭。</p>
      <form id="setup-form">
        <fieldset>
          <legend>网站信息</legend>
          <label for="site-name">网站名称</label>
          <input id="site-name" name="name" required maxlength="120" autocomplete="off" placeholder="我的博客" />
          <label for="site-description">网站简介</label>
          <input id="site-description" name="description" maxlength="1000" autocomplete="off" placeholder="这里记录些什么" />
          <p class="field-help">名称用于导航和页面标题，简介用于页面描述。名称最多 120 字节，简介最多 1000 字节。</p>
        </fieldset>
        <fieldset>
          <legend>站长账户</legend>
          <label for="setup-username">用户名</label>
          <input id="setup-username" name="username" autocomplete="username" required minlength="3" maxlength="32" pattern="[a-z][a-z0-9\-]{2,31}" aria-describedby="setup-username-help" />
          <p class="field-help" id="setup-username-help">3–32 位小写字母、数字或短横线，以字母开头。</p>
          <label for="setup-password">密码</label>
          <input id="setup-password" name="password" type="password" autocomplete="new-password" required maxlength="1024" aria-describedby="setup-password-help" />
          <p class="field-help" id="setup-password-help">12–1024 字节，请使用较长且不重复的密码。</p>
          <label for="setup-confirm">确认密码</label>
          <input id="setup-confirm" name="confirm" type="password" autocomplete="new-password" required maxlength="1024" />
        </fieldset>
        <fieldset>
          <legend>确认安装权限</legend>
          <label for="setup-token">安装密钥</label>
          <input id="setup-token" name="token" type="password" autocomplete="off" required maxlength="43" aria-describedby="setup-token-help" />
          <p class="field-help" id="setup-token-help">从服务器获取部署时生成的安装密钥，用于确认你有权初始化这个网站。</p>
          <details><summary>如何获取安装密钥</summary><p>在服务器的项目根目录执行以下命令，复制输出的密钥：</p><pre tabindex="0"><code>docker compose --env-file .env -f deploy/compose.yaml exec api cat /data/setup-token</code></pre><p>使用自定义配置文件或项目名时，沿用部署时的参数。不要公开或分享密钥。</p></details>
        </fieldset>
        <p class="form-status" role="status" aria-live="polite"></p>
        <button class="button" type="submit">完成安装</button>
      </form>
      <noscript><p class="notice">完成安装需要启用 JavaScript。</p></noscript>
    </> : <p class="notice" role="status">暂时无法读取安装状态，请确认数据库已初始化，再刷新此页面。</p>}
  </div>
</Base>
<style>
  .setup-shell { width: min(100% - 48px, 520px); margin: 46px auto 75px; }
  fieldset { border: 0; border-top: 1px solid var(--line); padding: 24px 0 0; margin: 28px 0; min-width: 0; }
  legend { font-weight: 600; padding: 0 16px 0 0; }
  details { font-size: 13px; color: var(--muted); }
  details p { margin: 12px 0; }
  form > .button { width: 100%; }
</style>
